package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
 <meta name="htmx-config" content='{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":true,"error":true}],"timeout":15000}'/>
 <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js" integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg" crossorigin="anonymous"></script>
			<link rel="stylesheet" href="/static/styles.css"/>
		</head>
		<body hx-sync="this:queue all">
			<a class="skip-link" href="#biblioteca">Ir a mi biblioteca</a>
			<header class="site-header">
				<div class="header-content">
					<a class="brand" href="/">Bookfly<span>Tu próxima página empieza acá.</span></a>
					<nav aria-label="Secciones de la biblioteca">
						<a href="#biblioteca">Libros</a>
						<a href="#autores">Autores</a>
						<a href="#editoriales">Editoriales</a>
						<a href="#usuarios">Usuarios</a>
					</nav>
				</div>
			</header>
			<main>
 <div id="mensajes" role="status" aria-live="polite"></div>
 <div id="estado" hidden hx-get="/estado" hx-trigger="catalogoActualizado from:body" hx-include="#libro-autor, #libro-editorial"></div>
 { children... }</main>
			<footer>Bookfly <span>Un lugar para cada libro.</span></footer>
		</body>
	</html>
}

templ ErrorPage(message string) {
	@Layout("Bookfly · No se pudo completar la solicitud") {
		<div class="intro">
			<h1>No se pudo completar la solicitud</h1>
			<p class="message error" role="alert">{ message }</p>
			<a href="/">Volver a la biblioteca</a>
		</div>
	}
}
