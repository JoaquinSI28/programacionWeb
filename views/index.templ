package views

templ IndexPage(data PageData) {
	@Layout("Bookfly · Mi biblioteca") {
		<div class="intro">
			<p class="eyebrow">UN ESPACIO PARA TUS HISTORIAS</p>
			<h1>Tu biblioteca, página a página.</h1>
			<p>Organizá tus libros y descubrí todo lo que hay detrás de cada título. Para empezar, agregá un autor y una editorial y después, tu primer libro.</p>
		</div>
		<section id="biblioteca" aria-labelledby="libros-heading">
			<div class="section-heading"><p class="eyebrow">01 / BIBLIOTECA</p><h2 id="libros-heading">Tus libros</h2></div>
			<div class="workspace">
				@EntityForm("libros", data)
				<div class="collection">@EntityList("libros", data, false)</div>
			</div>
		</section>
		<section id="autores" aria-labelledby="autores-heading">
			<div class="section-heading"><p class="eyebrow">02 / QUIÉNES ESCRIBEN</p><h2 id="autores-heading">Autores</h2></div>
			<div class="workspace">
				@EntityForm("autores", data)
				<div class="collection">@EntityList("autores", data, false)</div>
			</div>
		</section>
		<section id="editoriales" aria-labelledby="editoriales-heading">
			<div class="section-heading"><p class="eyebrow">03 / QUIÉNES PUBLICAN</p><h2 id="editoriales-heading">Editoriales</h2></div>
			<div class="workspace">
				@EntityForm("editoriales", data)
				<div class="collection">@EntityList("editoriales", data, false)</div>
			</div>
		</section>
		<section id="usuarios" aria-labelledby="usuarios-heading">
			<div class="section-heading"><p class="eyebrow">04 / LA COMUNIDAD</p><h2 id="usuarios-heading">Usuarios</h2></div>
			<div class="workspace">
				@EntityForm("usuarios", data)
				<div class="collection">@EntityList("usuarios", data, false)</div>
			</div>
		</section>
	}
}
