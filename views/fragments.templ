package views

templ OperationMessage(id, message string) {
	<div id={ id } hx-swap-oob="true" aria-live="polite">
		<p class="message error" role="alert">{ message }</p>
	</div>
}

templ EntityForm(entity string, data PageData) {
	switch entity {
	case "libros":
		@LibroForm(data)
	case "autores":
		@AutorForm(data.Today)
	case "editoriales":
		@EditorialForm()
	case "usuarios":
		@UsuarioForm()
	}
}
